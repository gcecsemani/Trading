# ─── Telegram ────────────────────────────────────────────────────────────────
# Get your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Get your Chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ─── Zerodha ─────────────────────────────────────────────────────────────────
# Create an app at https://developers.kite.trade/ to get these
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Run  python login_zerodha.py  each morning to refresh this token
ZERODHA_ACCESS_TOKEN=

# Your Zerodha client ID (e.g. AB1234)
ZERODHA_USER_ID=
